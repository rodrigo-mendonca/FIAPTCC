# ========== AMBIENTE ==========
ENVIRONMENT=local

# ========== CHROMADB ==========
CHROMADB_HOST=localhost
CHROMADB_PORT=8200

# ========== CORS ==========
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080
CHROMADB_DEFAULT_RESULTS=50

# ========== GENAI ==========
GENAI_PROVIDER=lmstudio
GENAI_ENDPOINT=http://localhost:1234/v1
GENAI_MODEL=openai/gpt-oss-20b
GENAI_API_KEY=lm-studio
GENAI_API_VERSION=
GENAI_TEMPERATURE=0.7
GENAI_MAX_TOKENS=2048
GENAI_TOP_P=0.95

# ========== EMBEDDINGS ==========
EMBEDDINGS_PROVIDER=lmstudio
EMBEDDINGS_ENDPOINT=http://localhost:1234/v1
EMBEDDINGS_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDINGS_API_KEY=lm-studio
EMBEDDINGS_API_VERSION=